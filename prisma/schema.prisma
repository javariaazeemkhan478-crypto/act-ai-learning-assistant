generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  email        String        @default("")
  passwordHash String
  firstName    String        @default("")
  lastName     String        @default("")
  createdAt    DateTime      @default(now())
  profile      UserProfile?
  roadmaps     Roadmap[]
  chatSessions ChatSession[]
  chatMessages ChatMessage[]
  debugQueries DebugQuery[]
  resumeScans  ResumeScan[]
}

model UserProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int      @default(1)
  lastActiveDate DateTime @default(now())
}

model Roadmap {
  id           Int           @id @default(autoincrement())
  userId       Int
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal         String
  level        String
  hoursPerWeek Int           @default(10)
  createdAt    DateTime      @default(now())
  jsonContent  Json          @default("{}")
  items        RoadmapItem[]
}

model RoadmapItem {
  id           Int     @id @default(autoincrement())
  roadmapId    Int
  roadmap      Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  weekNumber   Int     @default(1)
  topic        String
  subtopics    Json    @default("[]")
  resourceLink String  @default("")
  resources    Json    @default("[]")
  isCompleted  Boolean @default(false)
}

model ChatSession {
  id        Int           @id @default(autoincrement())
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("New Chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId Int?
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String       // user, assistant
  content   String
  imageUrl  String       @default("")
  timestamp DateTime     @default(now())
}

model DebugQuery {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputCode String
  framework String   @default("Auto-Detect")
  aiResponse String
  timestamp DateTime @default(now())
}

model ResumeScan {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeText     String
  jobDescription String   @default("")
  atsScore       Int      @default(0)
  feedbackJson   Json     @default("{}")
  createdAt      DateTime @default(now())
}
